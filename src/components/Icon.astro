---
// Inline Phosphor icons (MIT). Duotone for services, light for contact and social links.
import hardDrives from '@phosphor-icons/core/duotone/hard-drives-duotone.svg?raw';
import devices from '@phosphor-icons/core/duotone/devices-duotone.svg?raw';
import blueprint from '@phosphor-icons/core/duotone/blueprint-duotone.svg?raw';
import cloudArrowUp from '@phosphor-icons/core/duotone/cloud-arrow-up-duotone.svg?raw';
import usersThree from '@phosphor-icons/core/duotone/users-three-duotone.svg?raw';
import circuitry from '@phosphor-icons/core/duotone/circuitry-duotone.svg?raw';
import envelope from '@phosphor-icons/core/light/envelope-simple-light.svg?raw';
import linkedin from '@phosphor-icons/core/light/linkedin-logo-light.svg?raw';
import github from '@phosphor-icons/core/light/github-logo-light.svg?raw';
import mapPin from '@phosphor-icons/core/light/map-pin-light.svg?raw';
import arrowUpRight from '@phosphor-icons/core/light/arrow-up-right-light.svg?raw';

const icons = {
  'hard-drives': hardDrives,
  devices,
  blueprint,
  'cloud-arrow-up': cloudArrowUp,
  'users-three': usersThree,
  circuitry,
  envelope,
  linkedin,
  github,
  'map-pin': mapPin,
  'arrow-up-right': arrowUpRight,
} as const;

export type Name = keyof typeof icons;

interface Props {
  name: Name;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;
const svg = icons[name].replace(
  '<svg ',
  `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="icon ${className}" `,
);
---

<Fragment set:html={svg} />
