---
// A monolith that splits into independent services on one event stream.
// It plays once on load; with reduced motion it renders in its final state.
import { systems, systemsCaption } from '../data/profile';

const n = systems.length;

// Wide layout (tablet and desktop)
const W = 1200;
const boxW = 164;
const boxH = 60;
const gap = (W - n * boxW) / (n - 1);
const boxY = 10;
const busY = 140;
const packedStart = (W - n * boxW) / 2;
const wide = systems.map((name, i) => {
  const x = i * (boxW + gap);
  const packedX = packedStart + i * boxW;
  return { name, x, dx: packedX - x, delay: 0.25 + i * 0.06 };
});

// Tall layout (phones)
const TW = 340;
const tBoxW = 252;
const tBoxH = 44;
const tGap = 14;
const tBusX = 26;
const tBoxX = 66;
const TH = 20 + n * tBoxH + (n - 1) * tGap;
const tPackedStart = (TH - n * tBoxH) / 2;
const tall = systems.map((name, i) => {
  const y = 10 + i * (tBoxH + tGap);
  const packedY = tPackedStart + i * tBoxH;
  return { name, y, dy: packedY - y, delay: 0.25 + i * 0.06 };
});
---

<figure class="diagram">
  <svg class="wide" viewBox={`0 0 ${W} 150`} role="img" aria-labelledby="diagram-caption">
    <line class="bus" x1="0" y1={busY} x2={W} y2={busY} pathLength="1" />
    {
      wide.map((s) => (
        <line
          class="link"
          x1={s.x + boxW / 2}
          y1={boxY + boxH}
          x2={s.x + boxW / 2}
          y2={busY}
          style={`--delay:${s.delay + 0.9}s`}
        />
      ))
    }
    <circle class="pulse" r="5" cy={busY} cx="0" style={`--travel:${W}px`} />
    {
      wide.map((s) => (
        <g class="svc" style={`--dx:${s.dx}px; --dy:0px; --delay:${s.delay}s`}>
          <rect x={s.x} y={boxY} width={boxW} height={boxH} />
          <text x={s.x + boxW / 2} y={boxY + boxH / 2}>{s.name}</text>
        </g>
      ))
    }
  </svg>

  <svg class="tall" viewBox={`0 0 ${TW} ${TH}`} role="img" aria-labelledby="diagram-caption">
    <line class="bus" x1={tBusX} y1="10" x2={tBusX} y2={TH - 10} pathLength="1" />
    {
      tall.map((s) => (
        <line
          class="link"
          x1={tBusX}
          y1={s.y + tBoxH / 2}
          x2={tBoxX}
          y2={s.y + tBoxH / 2}
          style={`--delay:${s.delay + 0.9}s`}
        />
      ))
    }
    {
      tall.map((s) => (
        <g class="svc" style={`--dx:0px; --dy:${s.dy}px; --delay:${s.delay}s`}>
          <rect x={tBoxX} y={s.y} width={tBoxW} height={tBoxH} />
          <text x={tBoxX + tBoxW / 2} y={s.y + tBoxH / 2}>{s.name}</text>
        </g>
      ))
    }
  </svg>

  <figcaption id="diagram-caption">{systemsCaption}</figcaption>
</figure>

<style>
  .diagram {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .tall {
    display: none;
    max-width: 420px;
  }

  @media (max-width: 640px) {
    .wide {
      display: none;
    }
    .tall {
      display: block;
    }
  }

  .svc rect {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .svc text {
    fill: var(--ink);
    font-family: var(--font);
    font-size: 17px;
    font-weight: 560;
    font-stretch: 92%;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .tall .svc text {
    font-size: 16px;
  }

  .bus {
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .link {
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .pulse {
    fill: var(--pulse);
    opacity: 0;
  }

  figcaption {
    margin-top: 1.25rem;
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* The one orchestrated moment on the page. */
  @media (prefers-reduced-motion: no-preference) {
    .svc {
      animation: split 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) var(--delay) both;
    }

    .bus {
      stroke-dasharray: 1;
      animation: draw 0.8s ease-out 0.75s both;
    }

    .link {
      animation: appear 0.4s ease-out var(--delay) both;
    }

    .pulse {
      animation: travel 2.6s ease-in-out 1.9s 2 both;
    }
  }

  @keyframes split {
    from {
      transform: translate(var(--dx), var(--dy));
    }
    to {
      transform: translate(0, 0);
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes travel {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(var(--travel));
    }
  }
</style>
