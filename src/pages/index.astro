---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile, services, about } from '../data/profile';

const year = new Date().getFullYear();
const mailto = `mailto:${profile.email}`;
---

<Base>
  <header class="wrap top">
    <a class="wordmark" href="/" aria-label={`${profile.name}, home`}>{profile.name}</a>
    <nav aria-label="Sections">
      <a class="navlink" href="#services">Services</a>
      <a class="navlink" href="#about">About</a>
      <a class="talk" href="#contact">
        <Icon name="envelope" size={18} />
        <span>Let's talk</span>
      </a>
    </nav>
  </header>

  <main id="main">
    <section class="wrap hero" aria-labelledby="name">
      <h1 id="name">
        <span class="line"><span>{profile.firstName}</span></span>
        <span class="line"><span>{profile.lastName}</span></span>
      </h1>
      <div class="rule" aria-hidden="true"></div>

      <div class="hero-grid">
        <p class="role">{profile.role}</p>
        <div class="pitch">
          <p class="statement">{profile.statement}</p>
          <div class="actions">
            <a class="btn primary" href={mailto}>
              <Icon name="envelope" size={20} />
              <span>Start a project</span>
            </a>
            <a class="btn ghost" href="#services">Explore services</a>
          </div>
        </div>
      </div>

      <div class="meta">
        <p class="available"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
        <p class="where">
          <Icon name="map-pin" size={18} />
          <span>{profile.location}. Working remotely ({profile.timezone})</span>
        </p>
      </div>
    </section>

    <section id="services" class="wrap section" aria-labelledby="services-title">
      <div class="section-head">
        <h2 id="services-title">Services</h2>
        <p>Hands-on engineering and technical leadership for teams building products on Java.</p>
      </div>

      <ul class="services">
        {
          services.map((s) => (
            <li class="service">
              <Icon name={s.icon} size={40} class="service-icon" />
              <h3>{s.title}</h3>
              <p class="service-text">{s.text}</p>
              <p class="tools">{s.tools}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="about" class="wrap section about" aria-labelledby="about-title">
      <h2 id="about-title">About</h2>
      <div class="about-body">
        {about.text.map((t) => <p>{t}</p>)}
        <dl class="facts">
          {
            about.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section id="contact" class="wrap section" aria-labelledby="contact-title">
      <div class="panel">
        <div class="panel-intro">
          <h2 id="contact-title">Let's work together</h2>
          <p>Tell me about your product, your team and what you need. Email is the quickest way to reach me.</p>
          <a class="btn primary" href={mailto}>
            <Icon name="envelope" size={20} />
            <span>Email me</span>
          </a>
        </div>

        <ul class="channels">
          <li>
            <a class="channel" href={mailto}>
              <span class="badge"><Icon name="envelope" size={22} /></span>
              <span class="channel-text"><span class="label">Email</span><span class="value">{profile.email}</span></span>
              <Icon name="arrow-up-right" size={18} class="go" />
            </a>
          </li>
          <li>
            <a class="channel" href={profile.linkedin} rel="me noopener" target="_blank">
              <span class="badge"><Icon name="linkedin" size={22} /></span>
              <span class="channel-text"><span class="label">LinkedIn</span><span class="value">{profile.linkedinHandle}</span></span>
              <Icon name="arrow-up-right" size={18} class="go" />
            </a>
          </li>
          <li>
            <a class="channel" href={profile.github} rel="me noopener" target="_blank">
              <span class="badge"><Icon name="github" size={22} /></span>
              <span class="channel-text"><span class="label">GitHub</span><span class="value">{profile.githubHandle}</span></span>
              <Icon name="arrow-up-right" size={18} class="go" />
            </a>
          </li>
          <li>
            <div class="channel static">
              <span class="badge"><Icon name="map-pin" size={22} /></span>
              <span class="channel-text"><span class="label">Location</span><span class="value">{profile.location} ({profile.timezone})</span></span>
            </div>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <div class="foot">
    <p>© {year} {profile.name}</p>
    <ul class="socials" aria-label="Social links">
      <li><a class="social" href={mailto} aria-label="Email"><Icon name="envelope" size={20} /></a></li>
      <li><a class="social" href={profile.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a></li>
      <li><a class="social" href={profile.github} rel="me noopener" target="_blank" aria-label="GitHub"><Icon name="github" size={20} /></a></li>
    </ul>
    </div>
  </footer>
</Base>

<style>
  /* Header */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.75rem;
    padding-bottom: 1.75rem;
  }

  .wordmark {
    font-size: 1rem;
    font-weight: 560;
    font-stretch: 125%;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.25rem);
  }

  .navlink {
    color: var(--mist);
    font-size: 0.9375rem;
    transition: color 0.2s;
  }

  .navlink:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .navlink {
      display: none;
    }
  }

  .talk {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .talk :global(.icon) {
    color: var(--brass);
  }

  .talk:hover {
    background: var(--brass-soft);
    border-color: var(--brass);
  }

  /* Hero */
  .hero {
    padding-top: clamp(3.5rem, 11vw, 9rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  h1 {
    font-size: clamp(4.5rem, 14vw, 10.5rem);
    font-weight: 280;
    font-stretch: 125%;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }

  .line > span {
    display: block;
  }

  .rule {
    width: 72px;
    height: 1px;
    margin: clamp(2rem, 4vw, 3rem) 0;
    background: var(--brass);
    transform-origin: left;
  }

  .hero-grid {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .role {
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.35;
    max-width: 22ch;
  }

  .statement {
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    line-height: 1.6;
    color: var(--mist);
    max-width: 46ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.4rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 560;
    line-height: 1;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .primary {
    background: var(--ink);
    color: #ffffff;
  }

  .primary :global(.icon) {
    color: var(--brass);
  }

  .primary:hover {
    background: #22304a;
  }

  .ghost {
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .ghost:hover {
    border-color: var(--brass);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--mist);
    font-size: 0.9375rem;
  }

  .available,
  .where {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .where :global(.icon) {
    color: var(--brass);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brass);
    box-shadow: 0 0 0 4px var(--brass-soft);
  }

  /* Sections */
  .section {
    padding-top: clamp(4.5rem, 10vw, 8rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }

  h2 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 300;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .section-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-head p {
    color: var(--mist);
    max-width: 44ch;
    font-size: 1.125rem;
  }

  @media (min-width: 900px) {
    .section-head {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: end;
    }
  }

  /* Services: one grid, hairlines between cells */
  .services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .services {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }

  .service :global(.service-icon) {
    color: var(--brass);
  }

  h3 {
    margin-top: 1.75rem;
    font-size: 1.25rem;
    font-weight: 560;
    font-stretch: 106%;
    line-height: 1.3;
  }

  .service-text {
    margin-top: 0.75rem;
    color: var(--soft);
  }

  .tools {
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--mist);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  /* About */
  .about {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
    }
  }

  .about-body p {
    font-size: clamp(1.125rem, 1.8vw, 1.25rem);
    line-height: 1.65;
    color: var(--soft);
    max-width: 58ch;
  }

  .about-body p + p {
    margin-top: 1.25rem;
  }

  .facts {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .facts div {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  dt {
    color: var(--mist);
    font-size: 0.875rem;
  }

  dd {
    margin-top: 0.35rem;
    line-height: 1.45;
  }

  /* Contact */
  .panel {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.75rem, 5vw, 4rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  @media (min-width: 900px) {
    .panel {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .panel-intro p {
    margin: 1.25rem 0 2rem;
    color: var(--mist);
    max-width: 40ch;
  }

  .channel {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .channels li:first-child .channel {
    padding-top: 0;
  }

  .channels li:last-child .channel {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .badge {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg);
    color: var(--brass);
    transition: border-color 0.2s;
  }

  .channel-text {
    display: grid;
    min-width: 0;
  }

  .label {
    color: var(--mist);
    font-size: 0.8125rem;
  }

  .value {
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }

  .channel :global(.go) {
    color: var(--mist);
    transition:
      color 0.2s,
      transform 0.2s;
  }

  a.channel:hover .value {
    color: var(--brass);
  }

  a.channel:hover .badge {
    border-color: var(--brass);
  }

  a.channel:hover :global(.go) {
    color: var(--brass);
    transform: translate(2px, -2px);
  }

  /* Footer */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(4rem, 8vw, 6rem);
    padding-top: 2rem;
    padding-bottom: calc(2rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    color: var(--mist);
    font-size: 0.9375rem;
  }

  .socials {
    display: flex;
    gap: 0.625rem;
  }

  .social {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .social:hover {
    color: var(--brass);
    border-color: var(--brass);
  }

  /* The one orchestrated moment: the name rises, the rule draws, the rest settles in. */
  @media (prefers-reduced-motion: no-preference) {
    .line > span {
      animation: rise 1s cubic-bezier(0.2, 0.75, 0.1, 1) both;
    }

    .line:nth-child(2) > span {
      animation-delay: 0.12s;
    }

    .rule {
      animation: draw 0.8s cubic-bezier(0.6, 0, 0.2, 1) 0.55s both;
    }

    .hero-grid,
    .meta {
      animation: settle 0.9s ease-out 0.75s both;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
