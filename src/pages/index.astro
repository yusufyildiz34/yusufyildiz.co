---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CodeCard from '../components/CodeCard.astro';
import { profile, services, reasons, industries } from '../data/profile';

const year = new Date().getFullYear();
const mailto = `mailto:${profile.email}`;
---

<Base>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href="/" aria-label={`${profile.name}, home`}>
        <img class="mark" src="/favicon.svg" width="32" height="32" alt="" />
        <span>{profile.name}</span>
      </a>
      <nav aria-label="Sections">
        <a class="navlink" href="#services">Services</a>
        <a class="navlink" href="#about">About</a>
        <a class="navlink" href="#contact">Contact</a>
        <a class="btn dark small" href="#contact">Let's talk</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="pill"><span class="pulse" aria-hidden="true"></span>{profile.availability}</p>
          <h1 id="hero-title">{profile.headline}</h1>
          <p class="lead">{profile.intro}</p>
          <div class="actions">
            <a class="btn dark" href={mailto}>
              <Icon name="envelope" size={18} />
              <span>Start a project</span>
            </a>
            <a class="btn light" href="#services">View services</a>
          </div>
          <ul class="highlights">
            {
              profile.highlights.map((h) => (
                <li>
                  <Icon name="check-circle" size={18} />
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="hero-visual">
          <CodeCard />
        </div>
      </div>
    </section>

    <section id="services" class="section" aria-labelledby="services-title">
      <div class="wrap">
        <div class="head">
          <h2 id="services-title">How I can help</h2>
          <p>Hands-on engineering and technical leadership for teams building products on Java.</p>
        </div>
        <ul class="cards">
          {
            services.map((s) => (
              <li class="card">
                <span class="icon-box">
                  <Icon name={s.icon} size={26} />
                </span>
                <h3>{s.title}</h3>
                <p class="card-text">{s.text}</p>
                <p class="tools">{s.tools}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="about" class="section tint" aria-labelledby="about-title">
      <div class="wrap about">
        <div class="head about-head">
          <h2 id="about-title">Why teams work with me</h2>
          <p>
            I have been building production software since 2009, as an engineer and as a technical lead. My work
            spans {industries.charAt(0).toLowerCase() + industries.slice(1)}
          </p>
        </div>
        <ul class="reasons">
          {
            reasons.map((r) => (
              <li class="reason">
                <span class="icon-box">
                  <Icon name={r.icon} size={24} />
                </span>
                <div>
                  <h3>{r.title}</h3>
                  <p>{r.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="contact" class="section" aria-labelledby="contact-title">
      <div class="wrap">
        <div class="cta">
          <div class="cta-bg" aria-hidden="true"></div>
          <div class="cta-copy">
            <h2 id="contact-title">Have a project in mind?</h2>
            <p>Tell me about your product, your team and what you need. Email is the quickest way to reach me.</p>
            <div class="actions">
              <a class="btn white" href={mailto}>
                <Icon name="envelope" size={18} />
                <span>Email me</span>
              </a>
              <a class="btn outline" href={profile.linkedin} rel="me noopener" target="_blank">
                <Icon name="linkedin" size={18} />
                <span>Connect on LinkedIn</span>
              </a>
            </div>
          </div>

          <ul class="channels">
            <li>
              <a class="channel" href={mailto}>
                <span class="badge"><Icon name="envelope" size={20} /></span>
                <span class="channel-text"><span class="label">Email</span><span class="value">{profile.email}</span></span>
                <Icon name="arrow-up-right" size={18} class="go" />
              </a>
            </li>
            <li>
              <a class="channel" href={profile.linkedin} rel="me noopener" target="_blank">
                <span class="badge"><Icon name="linkedin" size={20} /></span>
                <span class="channel-text"><span class="label">LinkedIn</span><span class="value">{profile.linkedinHandle}</span></span>
                <Icon name="arrow-up-right" size={18} class="go" />
              </a>
            </li>
            <li>
              <a class="channel" href={profile.github} rel="me noopener" target="_blank">
                <span class="badge"><Icon name="github" size={20} /></span>
                <span class="channel-text"><span class="label">GitHub</span><span class="value">{profile.githubHandle}</span></span>
                <Icon name="arrow-up-right" size={18} class="go" />
              </a>
            </li>
            <li>
              <div class="channel">
                <span class="badge"><Icon name="map-pin" size={20} /></span>
                <span class="channel-text"><span class="label">Location</span><span class="value">{profile.location} ({profile.timezone})</span></span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <a class="brand" href="/">
        <img class="mark" src="/favicon.svg" width="32" height="32" alt="" />
        <span>{profile.name}</span>
      </a>
      <p class="copy">© {year} {profile.name}. {profile.role}.</p>
      <ul class="socials" aria-label="Social links">
        <li><a class="social" href={mailto} aria-label="Email"><Icon name="envelope" size={20} /></a></li>
        <li><a class="social" href={profile.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a></li>
        <li><a class="social" href={profile.github} rel="me noopener" target="_blank" aria-label="GitHub"><Icon name="github" size={20} /></a></li>
      </ul>
    </div>
  </footer>
</Base>

<style>
  /* Header */
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mark {
    display: block;
    width: 32px;
    height: 32px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 2rem);
  }

  .navlink {
    color: var(--soft);
    font-size: 0.9375rem;
    font-weight: 450;
    transition: color 0.15s;
  }

  .navlink:hover {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .navlink {
      display: none;
    }
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    height: 48px;
    padding: 0 1.35rem;
    border-radius: 12px;
    font-size: 0.9375rem;
    font-weight: 550;
    letter-spacing: -0.005em;
    white-space: nowrap;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      box-shadow 0.15s,
      transform 0.15s;
  }

  .btn.small {
    height: 38px;
    padding: 0 1rem;
    border-radius: 10px;
    font-size: 0.875rem;
  }

  .btn.dark {
    background: var(--ink);
    color: #ffffff;
    box-shadow: 0 1px 2px rgb(11 18 32 / 0.2), 0 6px 16px -6px rgb(11 18 32 / 0.35);
  }

  .btn.dark:hover {
    background: #1b2638;
    transform: translateY(-1px);
  }

  .btn.light {
    background: #ffffff;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    box-shadow: 0 1px 2px rgb(11 18 32 / 0.05);
  }

  .btn.light:hover {
    border-color: #b9c0cc;
  }

  .btn.white {
    background: #ffffff;
    color: var(--ink);
  }

  .btn.white:hover {
    background: #eef1f6;
  }

  .btn.outline {
    color: #ffffff;
    border: 1px solid rgb(255 255 255 / 0.22);
  }

  .btn.outline:hover {
    border-color: rgb(255 255 255 / 0.5);
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(11 18 32 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(11 18 32 / 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 70% 60% at 75% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 75% 40%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(3rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffff;
    color: var(--soft);
    font-size: 0.8125rem;
    font-weight: 500;
    box-shadow: 0 1px 2px rgb(11 18 32 / 0.04);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22a06b;
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: rgb(34 160 107 / 0.18);
  }

  h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.5rem, 5vw, 3.875rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .lead {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--soft);
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 2.25rem;
    color: var(--soft);
    font-size: 0.9375rem;
  }

  .highlights li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .highlights :global(.icon) {
    color: var(--accent);
  }

  .hero-visual {
    position: relative;
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    inset: 8% -6% -10% 6%;
    background: radial-gradient(closest-side, rgb(47 85 212 / 0.16), transparent);
    filter: blur(10px);
    z-index: -1;
  }

  @media (min-width: 1000px) {
    .hero-visual {
      transform: perspective(1600px) rotateY(-6deg) rotateX(2deg);
    }
  }

  /* Sections */
  .section {
    padding: clamp(4.5rem, 9vw, 7rem) 0;
  }

  .tint {
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .head {
    max-width: 640px;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  h2 {
    font-size: clamp(2rem, 4vw, 2.875rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .head p {
    margin-top: 1rem;
    color: var(--soft);
    font-size: 1.125rem;
  }

  .icon-box {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px rgb(47 85 212 / 0.1);
  }

  /* Service cards */
  .cards {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 680px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 1px 2px rgb(11 18 32 / 0.04);
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }

  .card:hover {
    border-color: var(--line-strong);
    box-shadow: 0 16px 32px -16px rgb(11 18 32 / 0.18);
    transform: translateY(-2px);
  }

  h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .card h3 {
    margin-top: 1.25rem;
  }

  .card-text {
    margin-top: 0.6rem;
    color: var(--soft);
    font-size: 0.96875rem;
  }

  .tools {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--mist);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .card-text + .tools {
    margin-top: auto;
  }

  /* About */
  .about {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1000px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 5rem;
      align-items: start;
    }

    .about-head {
      margin-bottom: 0;
    }
  }

  .reasons {
    display: grid;
    gap: 1rem;
  }

  .reason {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    padding: 1.5rem;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .reason p {
    margin-top: 0.35rem;
    color: var(--soft);
    font-size: 0.96875rem;
  }

  /* Contact */
  .cta {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2.5rem;
    padding: clamp(2rem, 5vw, 4rem);
    background: var(--navy);
    border-radius: 24px;
    color: #ffffff;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(600px 300px at 0% 0%, rgb(47 85 212 / 0.35), transparent 70%),
      linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size:
      auto,
      44px 44px,
      44px 44px;
    pointer-events: none;
  }

  .cta > :not(.cta-bg) {
    position: relative;
  }

  @media (max-width: 560px) {
    .cta {
      padding: 2rem 1.25rem;
      border-radius: 20px;
    }

    .channel {
      gap: 0.75rem;
      padding: 0.8rem 0.85rem;
    }

    .badge {
      width: 36px;
      height: 36px;
    }

    .value {
      font-size: 0.9375rem;
    }

    .channel :global(.go) {
      display: none;
    }
  }

  @media (min-width: 1000px) {
    .cta {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: center;
    }
  }

  .cta-copy p {
    margin-top: 1rem;
    max-width: 42ch;
    color: #b6c1d3;
    font-size: 1.0625rem;
  }

  .channels {
    display: grid;
    gap: 0.75rem;
  }

  .channel {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 14px;
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }

  a.channel:hover {
    background: rgb(255 255 255 / 0.07);
    border-color: rgb(255 255 255 / 0.18);
  }

  .badge {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.08);
    color: #ffffff;
  }

  .channel-text {
    display: grid;
    min-width: 0;
  }

  .label {
    color: #8e9bb0;
    font-size: 0.78rem;
  }

  .value {
    font-size: 0.98rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .channel :global(.go) {
    color: #8e9bb0;
    transition:
      color 0.15s,
      transform 0.15s;
  }

  a.channel:hover :global(.go) {
    color: #ffffff;
    transform: translate(2px, -2px);
  }

  /* Footer */
  .foot {
    border-top: 1px solid var(--line);
  }

  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-top: 2rem;
    padding-bottom: calc(2rem + env(safe-area-inset-bottom));
  }

  .copy {
    color: var(--mist);
    font-size: 0.875rem;
  }

  @media (min-width: 900px) {
    .copy {
      order: 0;
      flex: 1;
      text-align: center;
    }
  }

  .socials {
    display: flex;
    gap: 0.5rem;
  }

  .social {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--soft);
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }

  .social:hover {
    color: var(--ink);
    border-color: var(--line-strong);
    background: var(--bg-soft);
  }

  /* One orchestrated load: copy rises in, then the code card settles. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * {
      animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero-copy > :nth-child(2) {
      animation-delay: 0.06s;
    }
    .hero-copy > :nth-child(3) {
      animation-delay: 0.12s;
    }
    .hero-copy > :nth-child(4) {
      animation-delay: 0.18s;
    }
    .hero-copy > :nth-child(5) {
      animation-delay: 0.24s;
    }
    .hero-visual {
      animation: settle 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      translate: 0 24px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
