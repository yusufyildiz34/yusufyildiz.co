---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CodeCard from '../components/CodeCard.astro';
import { profile, services, reasons, industries, stats, faqs } from '../data/profile';

const year = new Date().getFullYear();
const mailto = `mailto:${profile.email}?subject=${encodeURIComponent('Project inquiry')}`;
---

<Base>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href="/" aria-label={`${profile.name}, home`}>
        <img class="mark" src="/favicon.svg" width="32" height="32" alt="" />
        <span>{profile.name}</span>
      </a>
      <nav aria-label="Sections">
        <a class="navlink" href="#services">Services</a>
        <a class="navlink" href="#about">About</a>
        <a class="navlink" href="#faq">FAQ</a>
        <a class="navlink" href="#contact">Contact</a>
        <a class="btn dark small" href="#contact">Let's talk</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="pill"><span class="pulse" aria-hidden="true"></span>{profile.availability}</p>
          <h1 id="hero-title">{profile.headline}</h1>
          <p class="lead">{profile.intro}</p>
          <div class="actions">
            <a class="btn dark" href={mailto}>
              <Icon name="envelope" size={18} />
              <span>Start a project</span>
            </a>
            <a class="btn light" href="#services">View services</a>
          </div>
          <ul class="highlights">
            {
              profile.highlights.map((h) => (
                <li>
                  <Icon name="check-circle" size={18} />
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="hero-visual">
          <CodeCard />
        </div>
      </div>
    </section>

    <section id="services" class="section tint" aria-labelledby="services-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="kicker">// Services</p>
            <h2 id="services-title">Engineering and leadership for Java teams</h2>
          </div>
          <p class="section-lead">
            Hands-on help across the whole product, from backend services and user-facing apps to the pipeline that ships them.
          </p>
        </div>

        <ul class="bento">
          {
            services.map((s) => (
              <li class:list={['svc', s.layout]}>
                <span class="tile">
                  <Icon name={s.icon} size={24} />
                </span>
                <div class="svc-body">
                  <h3>{s.title}</h3>
                  <p class="svc-text">{s.text}</p>
                </div>
                {s.layout === 'featured' && (
                  <div class="monitor" aria-hidden="true">
                    <div class="monitor-row"><span class="verb get">GET</span><span class="path">/orders/{'{id}'}</span><span class="code">200</span><span class="ms">9 ms</span></div>
                    <div class="monitor-row"><span class="verb post">POST</span><span class="path">/payments</span><span class="code">201</span><span class="ms">41 ms</span></div>
                    <div class="monitor-row"><span class="verb get">GET</span><span class="path">/actuator/health</span><span class="code">200</span><span class="ms">2 ms</span></div>
                  </div>
                )}
                <ul class="tags">
                  {s.tools.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="about" class="section" aria-labelledby="about-title">
      <div class="wrap about">
        <div class="about-intro">
          <p class="kicker">// About</p>
          <h2 id="about-title">Why teams work with me</h2>
          <p class="section-lead">
            I have been building production software since 2009, as an engineer and as a technical lead, for products in
            health IoT, mobile payments, telecom, digital identity and commodity trading.
          </p>
          <dl class="stats">
            {
              stats.map((st) => (
                <div>
                  <dt>{st.label}</dt>
                  <dd>{st.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="panel">
          <ul class="reasons">
            {
              reasons.map((r) => (
                <li class="reason">
                  <span class="tile">
                    <Icon name={r.icon} size={22} />
                  </span>
                  <div>
                    <h3>{r.title}</h3>
                    <p>{r.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="industries">
            <p class="industries-label">Industries</p>
            <ul class="tags">
              {industries.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="section tint" aria-labelledby="faq-title">
      <div class="wrap faq">
        <div class="faq-intro">
          <p class="kicker">// FAQ</p>
          <h2 id="faq-title">Frequently asked questions</h2>
          <p class="section-lead">Something else on your mind? <a class="inline" href={mailto}>Send me an email</a>.</p>
        </div>
        <div class="faq-list">
          {
            faqs.map((f, i) => (
              <details class="faq-item" open={i === 0}>
                <summary>
                  <h3>{f.q}</h3>
                  <span class="plus" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contact" class="section" aria-labelledby="contact-title">
      <div class="wrap">
        <div class="cta">
          <div class="cta-bg" aria-hidden="true"></div>
          <div class="cta-copy">
            <p class="kicker light">// Contact</p>
            <h2 id="contact-title">Have a project in mind?</h2>
            <p>Tell me about your product, your team and what you need. Email is the quickest way to reach me.</p>
            <div class="actions">
              <a class="btn white" href={mailto}>
                <Icon name="envelope" size={18} />
                <span>Email me</span>
              </a>
              <a class="btn outline" href={profile.linkedin} rel="me noopener" target="_blank">
                <Icon name="linkedin" size={18} />
                <span>Connect on LinkedIn</span>
              </a>
            </div>
          </div>

          <ul class="channels">
            <li>
              <a class="channel" href={mailto}>
                <span class="badge"><Icon name="envelope" size={20} /></span>
                <span class="channel-text"><span class="label">Email</span><span class="value">{profile.email}</span></span>
                <Icon name="arrow-up-right" size={18} class="go" />
              </a>
            </li>
            <li>
              <a class="channel" href={profile.linkedin} rel="me noopener" target="_blank">
                <span class="badge"><Icon name="linkedin" size={20} /></span>
                <span class="channel-text"><span class="label">LinkedIn</span><span class="value">{profile.linkedinHandle}</span></span>
                <Icon name="arrow-up-right" size={18} class="go" />
              </a>
            </li>
            <li>
              <a class="channel" href={profile.github} rel="me noopener" target="_blank">
                <span class="badge"><Icon name="github" size={20} /></span>
                <span class="channel-text"><span class="label">GitHub</span><span class="value">{profile.githubHandle}</span></span>
                <Icon name="arrow-up-right" size={18} class="go" />
              </a>
            </li>
            <li>
              <div class="channel">
                <span class="badge"><Icon name="map-pin" size={20} /></span>
                <span class="channel-text"><span class="label">Location</span><span class="value">{profile.location} ({profile.timezone})</span></span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <a class="brand" href="/">
        <img class="mark" src="/favicon.svg" width="32" height="32" alt="" />
        <span>{profile.name}</span>
      </a>
      <p class="copy">© {year} {profile.name}. {profile.role}.</p>
      <nav aria-label="Social links">
      <ul class="socials">
        <li><a class="social" href={mailto} aria-label="Email"><Icon name="envelope" size={20} /></a></li>
        <li><a class="social" href={profile.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a></li>
        <li><a class="social" href={profile.github} rel="me noopener" target="_blank" aria-label="GitHub"><Icon name="github" size={20} /></a></li>
      </ul>
      </nav>
    </div>
  </footer>
</Base>

<style>
  /* Header */
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mark {
    display: block;
    width: 32px;
    height: 32px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 2rem);
  }

  .navlink {
    color: var(--soft);
    font-size: 0.9375rem;
    font-weight: 450;
    transition: color 0.15s;
  }

  .navlink:hover {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .navlink {
      display: none;
    }
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    height: 48px;
    padding: 0 1.35rem;
    border-radius: 12px;
    font-size: 0.9375rem;
    font-weight: 550;
    letter-spacing: -0.005em;
    white-space: nowrap;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      box-shadow 0.15s,
      transform 0.15s;
  }

  .btn.small {
    height: 38px;
    padding: 0 1rem;
    border-radius: 10px;
    font-size: 0.875rem;
  }

  .btn.dark {
    background: var(--ink);
    color: #ffffff;
    box-shadow: 0 1px 2px rgb(11 18 32 / 0.2), 0 6px 16px -6px rgb(11 18 32 / 0.35);
  }

  .btn.dark:hover {
    background: #1b2638;
    transform: translateY(-1px);
  }

  .btn.light {
    background: #ffffff;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    box-shadow: 0 1px 2px rgb(11 18 32 / 0.05);
  }

  .btn.light:hover {
    border-color: #b9c0cc;
  }

  .btn.white {
    background: #ffffff;
    color: var(--ink);
  }

  .btn.white:hover {
    background: #eef1f6;
  }

  .btn.outline {
    color: #ffffff;
    border: 1px solid rgb(255 255 255 / 0.22);
  }

  .btn.outline:hover {
    border-color: rgb(255 255 255 / 0.5);
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(11 18 32 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(11 18 32 / 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 70% 60% at 75% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 75% 40%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(3rem, 6vw, 4rem);
    align-items: center;
  }

  /* Let the code card shrink with the column so narrow screens never clip the hero text. */
  .hero-grid > * {
    min-width: 0;
  }

  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffff;
    color: var(--soft);
    font-size: 0.8125rem;
    font-weight: 500;
    box-shadow: 0 1px 2px rgb(11 18 32 / 0.04);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22a06b;
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: rgb(34 160 107 / 0.18);
  }

  h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.5rem, 5vw, 3.875rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .lead {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--soft);
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 2.25rem;
    color: var(--soft);
    font-size: 0.9375rem;
  }

  .highlights li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .highlights :global(.icon) {
    color: var(--accent);
  }

  .hero-visual {
    position: relative;
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    inset: 8% -6% -10% 6%;
    background: radial-gradient(closest-side, rgb(47 85 212 / 0.16), transparent);
    filter: blur(10px);
    z-index: -1;
  }

  @media (min-width: 1000px) {
    .hero-visual {
      transform: perspective(1600px) rotateY(-6deg) rotateX(2deg);
    }
  }

  /* Sections */
  .section {
    padding: clamp(4.5rem, 9vw, 7.5rem) 0;
  }

  .tint {
    background:
      radial-gradient(900px 400px at 100% 0%, rgb(47 85 212 / 0.05), transparent 70%),
      var(--bg-soft);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .kicker {
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .kicker.light {
    color: #8fb3ff;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 2.875rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .section-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  @media (min-width: 1000px) {
    .section-head {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: end;
    }
  }

  .section-lead {
    color: var(--soft);
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 52ch;
  }

  .tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: linear-gradient(150deg, #1d2b49 0%, #0c1424 70%);
    color: #8fb3ff;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 6px 14px -6px rgb(11 18 32 / 0.45);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li {
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--soft);
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* Services bento */
  .bento {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .svc.featured,
    .svc.wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1040px) {
    .bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .svc.featured {
      grid-column: span 2;
    }
  }

  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow:
      0 1px 2px rgb(11 18 32 / 0.04),
      0 12px 32px -20px rgb(11 18 32 / 0.18);
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }

  .svc:hover {
    border-color: rgb(47 85 212 / 0.28);
    box-shadow:
      0 1px 2px rgb(11 18 32 / 0.04),
      0 24px 44px -24px rgb(11 18 32 / 0.28);
    transform: translateY(-2px);
  }

  h3 {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .svc-text {
    margin-top: 0.55rem;
    color: var(--soft);
    font-size: 0.96875rem;
    line-height: 1.65;
  }

  .svc .tags {
    margin-top: auto;
    padding-top: 0.25rem;
  }

  /* Featured card: dark, with a small API monitor */
  .svc.featured {
    background: var(--navy);
    border-color: #1d2a40;
    color: #ffffff;
    overflow: hidden;
    isolation: isolate;
  }

  .svc.featured::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(520px 260px at 100% 0%, rgb(47 85 212 / 0.35), transparent 70%),
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size:
      auto,
      40px 40px,
      40px 40px;
  }

  .svc.featured:hover {
    border-color: #2b3c5c;
  }

  .svc.featured .tile {
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .svc.featured h3 {
    font-size: clamp(1.375rem, 2.2vw, 1.625rem);
  }

  .svc.featured .svc-text {
    color: #b6c1d3;
    max-width: 46ch;
    font-size: 1rem;
  }

  .svc.featured .tags li {
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.1);
    color: #c3cede;
  }

  .monitor {
    display: grid;
    gap: 0.35rem;
    padding: 0.85rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 14px;
    background: rgb(5 10 20 / 0.45);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .monitor-row {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) 1.75rem 2.75rem;
    gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 0.55rem;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.03);
    color: #c3cede;
  }

  .verb {
    font-weight: 600;
  }

  .verb.get {
    color: #6fd6c3;
  }

  .verb.post {
    color: #f2c879;
  }

  .path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .code {
    color: #8fd9a8;
  }

  .ms {
    color: #6f809a;
    text-align: right;
  }

  @media (min-width: 1040px) {
    .svc.featured {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      column-gap: 2.25rem;
    }

    .svc.featured .tile,
    .svc.featured .svc-body,
    .svc.featured .tags {
      grid-column: 1;
    }

    .svc.featured .monitor {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: center;
    }
  }

  /* Wide card: one row on large screens */
  @media (min-width: 1040px) {
    .svc.wide {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 0.8fr);
      align-items: center;
      column-gap: 1.75rem;
    }

    .svc.wide .tags {
      margin-top: 0;
      padding-top: 0;
      justify-content: flex-end;
    }
  }

  /* About */
  .about {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1000px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 5rem;
      align-items: center;
    }
  }

  .about-intro .section-lead {
    margin-top: 1.25rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .stats div {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.25rem 1rem 0 0;
  }

  .stats dd {
    order: -1;
  }

  .stats div + div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }

  .stats dd {
    font-size: clamp(1.875rem, 3.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stats dt {
    color: var(--mist);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .panel {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 24px;
    box-shadow:
